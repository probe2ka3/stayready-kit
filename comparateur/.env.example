# ---------------------------------------------------------------------------
# Configuration du comparateur. Copier en .env et renseigner.
# AUCUN secret ne doit être versionné : .env est ignoré par git.
# ---------------------------------------------------------------------------

# URL publique (métadonnées, sitemap, données structurées)
SITE_URL=https://www.exemple.ch

# Données : "postgres" (production) ou "memory" (démonstration sans base)
DATA_BACKEND=postgres
DATABASE_URL=postgres://cabas:CHANGER_MOI@localhost:5432/cabas
# TLS vers la base (recommandé hors réseau privé)
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
# Utilisé par docker-compose uniquement
POSTGRES_PASSWORD=CHANGER_MOI

# Données ouvertes et imports (par défaut : ./data)
# DATA_DIR=/app/data
# IMPORT_DIR=/app/data/imports/inbox

# Administration (fermée si ces valeurs sont absentes)
ADMIN_USERNAME=admin
# Généré par : node apps/web/scripts/hash-password.mjs
ADMIN_PASSWORD_HASH=
# 32 caractères aléatoires au minimum, ex. : openssl rand -base64 48
SESSION_SECRET=

# Derrière un proxy inverse de confiance (lecture de X-Forwarded-For pour la limitation de débit)
TRUST_PROXY=false

# Itinéraires routiers : serveur OSRM compatible (auto-hébergé). Vide = estimation.
OSRM_URL=

# Succursales OpenStreetMap (tâche hebdomadaire)
OVERPASS_URL=https://overpass.osm.ch/api/interpreter
# Agent HTTP identifiable pour toutes les collectes, avec contact de l'exploitant (jamais un agent de navigateur)
HTTP_USER_AGENT=TesPrixBot/1.0 (+https://www.exemple.ch/robot; contact@exemple.ch)

# Collecte des prix réels (docs/audit/03-sources-prix.md)
CRAWL_MIN_DELAY_MS=3000
# RAW_ARCHIVE_DIR=/app/data/raw
RAW_ARCHIVE_DAYS=30
# Sources : "off" pour désactiver immédiatement
LIDL_WEB=on
# Fiches produits Lidl relues par jour (rotation : tout l'assortiment en 7 jours)
LIDL_PRODUCT_PAGES_PER_RUN=460
# Aldi Suisse : API publique du site (docs/DATA_SURFACES.md §3) — ⚖️ avis juridique avant ouverture
ALDI_API=on
OPEN_PRICES=on
OPEN_PRICES_MAX_AGE_DAYS=400
# FoodAlly : fournisseur tiers, comparaison uniquement (quota anonyme 100 requêtes/jour)
FOODALLY=off
FOODALLY_MAX_QUERIES=50
FOODALLY_DAILY_RESERVE=10
# Repli sur un fournisseur tiers pour les prix affichés : UNIQUEMENT avec une licence souscrite
# et des correspondances revues (valeur possible : foodally)
PRICE_FALLBACK_SOURCES=
# Droits de réutilisation (docs/DROITS_DONNEES.md). Les sources dont les conditions restreignent
# l'usage (Aldi : « fins privées uniquement ») sont exclues de l'affichage en production, sauf
# autorisation écrite enregistrée ici (identifiants de connecteur, ex. « aldi-api »).
AUTHORIZED_SOURCES=
# exclude | include (défaut : exclude en production, include pour l'aperçu local privé).
RESTRICTED_SOURCES=

# Données servies : live (réel uniquement) | demo (fictif uniquement) | auto
PRICE_DATA=live
# Données de démonstration : false pour ne plus les générer (production avec prix réels)
DEMO_DATA=false

# Lancement : "waitlist" tant que le service n'est pas validé (page d'attente seule)
PUBLIC_ACCESS=waitlist
# Accès de prévisualisation : https://<domaine>/fr?acces=<jeton> (≥ 16 caractères aléatoires)
PREVIEW_TOKEN=
# Liste d'attente (PostgreSQL requis) : n'ouvrir qu'avec la politique de confidentialité complétée
SIGNUP_ENABLED=false
PILOT_CANTONS=GE,VD,NE,FR,VS,JU

# Paiement : seul "none" (désactivé) existe
BILLING_PROVIDER=none

# Coûts déclarés (CHF), affichés dans les indicateurs d'administration
COST_HOSTING_CHF_MONTH=0
COST_DATABASE_CHF_MONTH=0
COST_ROUTING_CHF_MONTH=0
COST_DATA_CHF_MONTH=0
COST_DOMAIN_CHF_YEAR=0
